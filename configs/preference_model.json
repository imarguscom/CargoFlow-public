{
  "model": "LightGBM",
  "objective": "binary",
  "negatives_per_positive": 3,
  "negative_sampling_seed": 20260907,
  "feature_storage": "float32 disk-backed memmap",
  "max_in_memory_examples": 0,
  "validation_fraction": 0.2,
  "lambda_candidates": [0.0, 0.02, 0.05, 0.1, 0.15],
  "features": [
    "travel_seconds",
    "origin_rel_lat",
    "origin_rel_lng",
    "destination_rel_lat",
    "destination_rel_lng",
    "origin_demand_cm3",
    "destination_demand_cm3",
    "origin_service_seconds",
    "destination_service_seconds",
    "origin_window_start_remaining_seconds",
    "origin_window_end_remaining_seconds",
    "destination_window_start_remaining_seconds",
    "destination_window_end_remaining_seconds",
    "station_code",
    "weekday",
    "departure_hour",
    "route_size",
    "capacity_utilisation",
    "same_zone"
  ],
  "fit_scope": "non-benchmark station-day groups only",
  "validation_selection": "station/date/customer-count stratified round-robin",
  "inference_scope": "new route, package, and travel records only"
}
